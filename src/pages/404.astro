---
import Layout from '../components/Layout.astro';
---

<Layout title="Lost — Ciphriend">
  <section class="max-w-md text-center mx-auto py-20">
    <p class="font-display text-xs uppercase tracking-[0.2em] text-primary mb-2">
      &#47;&#47; 404
    </p>
    <h1 class="text-4xl font-display tracking-tight mb-3">Lost in the alphabet.</h1>
    <p class="text-muted-foreground mb-6">
      We couldn't decode that URL. Try heading back home.
    </p>
    <a
      href="/"
      class="inline-block px-4 py-2 rounded-md border border-primary text-primary hover:bg-primary/10 font-display text-sm transition-colors"
    >
      ← Back home
    </a>
  </section>
</Layout>
