---
import '../styles/global.css';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ciphriend — Your friend for ciphers',
  description = 'Cipher encoding, decoding, and visualization. Everything runs in your browser. Nothing is ever sent to a server.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ciphriend" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground">
    <Navbar />
    <main class="flex-1 w-full max-w-6xl mx-auto px-6 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
