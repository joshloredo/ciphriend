---
import type { CipherSpec } from '../ciphers/_types';
import CipherCard from './CipherCard.astro';

interface Props {
  ciphers: CipherSpec[];
}
const { ciphers } = Astro.props;
---

<section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {ciphers.map((c) => <CipherCard cipher={c} />)}
</section>
