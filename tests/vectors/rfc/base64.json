      "mode": "encode"
    },
    {
      "id": "rfc4648-4-foo",
      "comment": "BASE64('foo') = 'Zm9v' (RFC 4648 §10).",
      "input": "foo",
      "opts": {},
      "expected": "Zm9v",
      "mode": "encode"
    },
    {
      "id": "rfc4648-5-foob",
      "comment": "BASE64('foob') = 'Zm9vYg==' (RFC 4648 §10).",
      "input": "foob",
      "opts": {},
      "expected": "Zm9vYg==",
      "mode": "encode"
    },
    {
      "id": "rfc4648-6-fooba",
      "comment": "BASE64('fooba') = 'Zm9vYmE=' (RFC 4648 §10).",
      "input": "fooba",
      "opts": {},
      "expected": "Zm9vYmE=",
      "mode": "encode"
    },
    {
      "id": "rfc4648-7-foobar",
      "comment": "BASE64('foobar') = 'Zm9vYmFy' (RFC 4648 §10).",
