      "expected": "foobar",
      "mode": "decode"
    },
    {
      "id": "decode-with-whitespace",
      "comment": "Decoder tolerates internal whitespace (common in line-wrapped Base64).",
      "input": "Zm9v\nYmFy",
      "opts": {},
      "expected": "foobar",
      "mode": "decode"
    },
    {
